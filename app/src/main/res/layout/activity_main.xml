<?xml version="1.0" encoding="utf-8"?>
<!-- S22: minimal layout. Web area on top, floating pill bar at the bottom (home, address, tabs, menu).
     Back / forward / reload / bookmark moved into the menu sheet (MenuSheet). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mg_bg"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:id="@+id/web_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:indeterminate="false"
            android:max="100"
            android:visibility="gone"
            app:indicatorColor="?attr/colorPrimary"
            app:trackColor="@color/mg_surface_variant"
            app:trackThickness="2dp" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginStart="10dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_bar_pill"
        android:elevation="3dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <ImageView
            android:id="@+id/btn_home"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Home"
            android:focusable="true" android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_home" />

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="36dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Back"
            android:focusable="true"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_back"
            android:tooltipText="Back"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/btn_fwd"
            android:layout_width="36dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Forward"
            android:focusable="true"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_forward"
            android:tooltipText="Forward"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btn_engine"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="2dp"
            android:clickable="true"
            android:contentDescription="Search engine"
            android:focusable="true"
            android:gravity="center"
            android:textColor="?attr/colorPrimary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <EditText
            android:id="@+id/url_bar"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_url_field"
            android:drawablePadding="6dp"
            android:ellipsize="end"
            android:hint="Search or type URL"
            android:importantForAutofill="no"
            android:imeOptions="actionGo"
            android:inputType="textUri"
            android:maxLines="1"
            android:paddingStart="18dp"
            android:paddingEnd="16dp"
            android:singleLine="true"
            android:textColor="@color/mg_text"
            android:textColorHint="@color/mg_text_dim"
            android:textSize="15sp" />

        <!-- 0.0.335: Privacy shield sits INSIDE the right end of the address field (Brave look). Negative start margin overlaps the field; when GONE it takes no room. -->
        <ImageView
            android:id="@+id/btn_shield"
            android:layout_width="34dp"
            android:layout_height="44dp"
            android:layout_marginStart="-38dp"
            android:layout_marginEnd="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Privacy Guard"
            android:focusable="true"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_shield"
            android:visibility="gone" />

        <!-- 0.0.286: Social chip (letter badge), shown on social sites only -->
        <TextView
            android:id="@+id/btn_social"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginEnd="6dp"
            android:clickable="true"
            android:contentDescription="Social tools"
            android:focusable="true"
            android:gravity="center"
            android:textColor="?attr/colorPrimary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- 0.0.319: Chrome-style "+" new tab button next to the address bar (tap = new tab, hold = new private tab) -->
        <ImageView
            android:id="@+id/btn_newtab"
            android:layout_width="34dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="New tab"
            android:focusable="true"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_add"
            android:tooltipText="New tab" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_tabs"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:contentDescription="Tabs"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="1"
            android:textSize="13sp"
            android:textStyle="bold"
            app:cornerRadius="8dp"
            app:strokeWidth="2dp" />

        <ImageView
            android:id="@+id/btn_menu"
            android:layout_width="40dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Menu"
            android:focusable="true" android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_more" />
    </LinearLayout>
</LinearLayout>
