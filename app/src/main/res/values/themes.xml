<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.MGB" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/mg_primary</item>
        <item name="colorOnPrimary">@color/mg_on_primary</item>
        <item name="colorSurface">@color/mg_surface</item>
        <item name="colorOnSurface">@color/mg_text</item>
        <item name="colorSurfaceVariant">@color/mg_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/mg_text_dim</item>
        <item name="colorOutline">@color/mg_outline</item>
        <item name="colorError">@color/mg_error</item>
        <!-- S29: dialogs (Theme picker etc.) used the default light container colour with light text in dark mode -->
        <item name="colorSurfaceContainerLowest">@color/mg_bg</item>
        <item name="colorSurfaceContainerLow">@color/mg_surface</item>
        <item name="colorSurfaceContainer">@color/mg_surface</item>
        <item name="colorSurfaceContainerHigh">@color/mg_surface_variant</item>
        <item name="colorSurfaceContainerHighest">@color/mg_surface_variant</item>
        <!-- 0.0.345: dialogs use our own list rows (see styles below) -->
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.MGB.MaterialAlertDialog</item>
        <item name="android:colorBackground">@color/mg_bg</item>
        <item name="android:windowBackground">@color/mg_bg</item>
        <item name="android:statusBarColor">@color/mg_bg</item>
        <item name="android:navigationBarColor">@color/mg_bg</item>
        <item name="android:windowLightStatusBar">@bool/mg_light_bars</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">@bool/mg_light_bars</item>
    </style>
    <style name="ThemeOverlay.MGB.MaterialAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="alertDialogStyle">@style/MGB.AlertDialog</item>
    </style>
    <style name="MGB.AlertDialog" parent="MaterialAlertDialog.Material3">
        <item name="listItemLayout">@layout/mg_dialog_item</item>
        <item name="singleChoiceItemLayout">@layout/mg_dialog_singlechoice</item>
        <item name="multiChoiceItemLayout">@layout/mg_dialog_multichoice</item>
    </style>
</resources>
